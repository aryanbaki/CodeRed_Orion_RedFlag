# Server only. Copy to ignored .env; fill values locally. Never bundle this file.
GEMINI_API_KEY=
# Exact enabled generateContent model ID from your Google project; no automatic fallback.
GEMINI_MODEL=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
REDFLAG_DEMO_TOKEN=
# Exact installed development extension origin, e.g. chrome-extension://<32-letter-id>
REDFLAG_ALLOWED_ORIGIN=
PORT=8787
