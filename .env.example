# SERVER ONLY. Paste provider keys here locally; never into chat or extension code.
# Gemini is implemented. Other providers below are reserved for future adapters.
AI_PROVIDER=gemini

# Select exactly one: free, paid, or default. No automatic paid fallback.
GEMINI_PROFILE=free
# Paste your FREE-PROJECT Gemini key immediately after the = below:
GEMINI_FREE_API_KEY=
# Paste your PAID-PROJECT Gemini key immediately after the = below (optional):
GEMINI_PAID_API_KEY=
# Model enabled in your project. Optional per-profile overrides below.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_FREE_MODEL=
GEMINI_PAID_MODEL=
# Legacy single-key option: set GEMINI_PROFILE=default to use this key.
GEMINI_API_KEY=

# Future OpenAI API (ChatGPT models). Adapter not implemented yet.
OPENAI_API_KEY=
OPENAI_MODEL=
# Future Anthropic Claude API. Adapter not implemented yet.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Future custom/cloud API. Adapter/protocol must be implemented before use.
CUSTOM_API_KEY=
CUSTOM_API_BASE_URL=
CUSTOM_API_MODEL=

# Local demo access credential, separate from any AI-provider key.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
REDFLAG_DEMO_TOKEN=
# Exact installed development extension origin, e.g. chrome-extension://<32-letter-id>
REDFLAG_ALLOWED_ORIGIN=
PORT=8787

# Server grading identity is fixed in source: redflag.rubric.v3 (prompt redflag.prompt.v2).
# Match these versions in trusted extension backend setup; they are not environment overrides.
