{
  "name": "policy-review-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "research:probe": "node scripts/probe.mjs",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:ui": "npm run build && node tests/ui-browser.mjs",
    "test:discovery-browser": "npm run build && node tests/discovery-browser.mjs",

    "start:server": "node --experimental-strip-types --env-file=.env src/server/main.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
