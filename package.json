{
  "name": "policy-review-framework",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "research:probe": "node scripts/probe.mjs",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:ui": "npm run build && node tests/ui-browser.mjs",
    "test:discovery-browser": "npm run build && node tests/discovery-browser.mjs",
    "start:server": "node --experimental-strip-types --env-file=.env src/server/main.ts",
    "test:backend-browser": "node --experimental-strip-types tests/backend-browser.ts",
    "test:actions-browser": "npm run build && node tests/actions-browser.mjs",
    "test:site-discovery": "npm run build && node tests/site-discovery-browser.mjs",
    "test:dashboard": "npm run build && node tests/dashboard-browser.mjs",
    "test:popup-redesign": "npm run build && node tests/popup-redesign.mjs",
    "test:vault": "npm run build && node tests/device-vault-browser.mjs",
    "test:branding": "npm run build && node tests/branding-browser.mjs",
    "test:integration": "npm run build && node --experimental-strip-types tests/site-review-integration.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
