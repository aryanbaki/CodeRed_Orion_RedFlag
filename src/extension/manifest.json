{
  "manifest_version": 3,
  "name": "RedFlag",
  "version": "1.0.0",
  "description": "Simple grades for website privacy, terms, and cookie policies.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RedFlag",
    "default_icon": {
      "16": "icons/redflag-16.png",
      "32": "icons/redflag-32.png",
      "48": "icons/redflag-48.png",
      "128": "icons/redflag-128.png"
    }
  },
  "icons": {
    "16": "icons/redflag-16.png",
    "32": "icons/redflag-32.png",
    "48": "icons/redflag-48.png",
    "128": "icons/redflag-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: http:"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "127",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "key": ""
}
